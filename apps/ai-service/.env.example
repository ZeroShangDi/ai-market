# Run scripts/configure-local.py to generate these; never commit real values.
AI_INTERNAL_TOKEN=
AI_STORAGE_KEY=
AI_DATABASE_PASSWORD=
# DeepSeek defaults: fill only AI_MODEL_API_KEY.
# Root URL, excluding /v1; endpoint path can be overridden separately.
AI_MODEL_API_KEY=
AI_MODEL_BASE_URL=https://api.deepseek.com
AI_MODEL_STREAM_USAGE=true
AI_MODEL_NAME=deepseek-flash
AI_MODEL_COMPLETIONS_PATH=/chat/completions
AI_MODEL_THINKING=disabled
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONTEXT_MESSAGES=12
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_CONCURRENT=8
AI_REQUESTS_PER_MINUTE=10
AI_GENERATION_SECONDS=180
# Generated alongside Agent/backend credentials by scripts/configure-agent-local.py.
AGENT_INTERNAL_TOKEN=
AGENT_SERVICE_URL=http://127.0.0.1:48082
