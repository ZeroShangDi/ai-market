# Load into service processes; never commit real credentials.
VOICE_BIND_HOST=127.0.0.1
VOICE_PORT=48083
# Same random >=32-character secret in the authenticated Java gateway.
VOICE_TICKET_SECRET=
# Gateway only: dedicated HTTPS origin serving the voice service at /.
VOICE_PUBLIC_URL=

# Fast model, OpenAI-compatible chat completions, independent of Agent SDK.
VOICE_LLM_URL=https://api.deepseek.com/v1
VOICE_LLM_MODEL=deepseek-flash
VOICE_LLM_API_KEY=

# HTTP is utterance recognition, not streaming ASR.
# openai-realtime requires a Realtime transcription compatible server.
VOICE_STT_PROTOCOL=openai-http
VOICE_STT_URL=
VOICE_STT_MODEL=
VOICE_STT_API_KEY=

VOICE_TTS_URL=http://127.0.0.1:48084/v1
VOICE_TTS_MODEL=qwen3-tts
VOICE_TTS_API_KEY=
VOICE_TTS_VOICE=default
VOICE_TTS_SAMPLE_RATE=24000

# Optional read-only complex analysis/search through the existing Agent service.
AGENT_SERVICE_URL=http://127.0.0.1:48082
AGENT_INTERNAL_TOKEN=

# Optional independent Apple Silicon worker; local resources stay server-side.
QWEN_TTS_TOKEN=
QWEN_TTS_MODEL_PATH=
# Only used when QWEN_TTS_MODE=clone.
QWEN_TTS_REFERENCE_AUDIO=
QWEN_TTS_REFERENCE_TEXT=
QWEN_TTS_INTERVAL=0.3
QWEN_TTS_PORT=48084

# Mac utterance ASR worker (set VOICE_STT_PROTOCOL=qwen-mlx-http).
QWEN_ASR_TOKEN=
QWEN_ASR_MODEL_PATH=
QWEN_ASR_PORT=48085

# Optional legacy read-only worker. Work plugins use the durable service at AGENT_SERVICE_URL.
VOICE_LOCAL_AGENT=false
VOICE_LOCAL_AGENT_PORT=48086

# Deployment-managed conversation capability plugins; [] disables all tools.
VOICE_PLUGINS=["work_control"]
