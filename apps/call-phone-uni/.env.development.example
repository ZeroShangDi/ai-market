# Copy to .env.development to show an explicitly labeled synthetic preview.
VITE_MOBILE_MOCK=true
# Disable mock for actual PC/mobile integration. Set a phone-reachable service URL.
# VITE_CUSTOMER_API_BASE_URL=https://customer-data.example

# VITE_CUSTOMER_TENANT_ID=1

# Signed update metadata, independent of business API credentials. No default public source.
# VITE_UPDATE_MANIFEST_URL=https://updates.example/manifest.json
# VITE_UPDATE_PUBLIC_KEY=<RSA public key in SPKI DER base64; never the private key>
# VITE_UPDATE_DOWNLOAD_ORIGINS=https://updates.example,https://cdn.example
# VITE_UPDATE_CHANNEL=stable
