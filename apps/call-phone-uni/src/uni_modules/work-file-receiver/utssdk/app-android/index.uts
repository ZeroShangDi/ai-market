import { UTSAndroid } from 'io.dcloud.uts'
import { WorkFileInbox, WorkFileShare } from 'dev.aimarket.workfiles'
export function pendingFiles(): string {
  const context = UTSAndroid.getAppContext()
  if (context == null) return '[]'
  return WorkFileInbox.pending(context)
}
export function readPendingFile(id: string): string {
  const context = UTSAndroid.getAppContext()
  if (context == null) throw new Error('应用尚未就绪')
  return WorkFileInbox.read(context, id)
}
export function discardPendingFile(id: string): boolean {
  const context = UTSAndroid.getAppContext()
  if (context == null) return false
  return WorkFileInbox.discard(context, id)
}

export function readDocument(uri: string): string {
  const context = UTSAndroid.getAppContext()
  if (context == null) throw new Error('应用尚未就绪')
  return WorkFileInbox.readDocument(context, uri)
}

export function shareDocument(path: string, name: string, callback: (error: string) => void): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) throw new Error('应用尚未就绪')
  WorkFileShare.launch(activity, path, name, callback)
}

export function shareTextDocument(name: string, content: string, callback: (error: string) => void): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) throw new Error('应用尚未就绪')
  WorkFileShare.launchText(activity, name, content, callback)
}
