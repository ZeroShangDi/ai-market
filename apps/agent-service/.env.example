AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=48082
AGENT_DATA_DIR=.data
AGENT_INTERNAL_TOKEN=replace-with-random-at-least-32-characters
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Leave empty for provider default: anthropic=claude-sonnet-4-6; deepseek=deepseek-flash
AGENT_MODEL=
# Optional absolute operator-managed JSON path. Never use user-uploaded settings.
WORK_MANAGED_CONFIG=

# Operator-managed local capability plugin roots (JSON array of absolute paths).
WORK_CAPABILITY_PLUGINS=[]
# Call Phone plugin connector; only required when that plugin is enabled.
# Local: http://127.0.0.1:48080/admin-api/callphone/plugin/leads/import
WORK_BUSINESS_URL=
